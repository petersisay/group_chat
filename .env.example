# ==============================================================
# Group Chat Studio - Environment Configuration Template
# DO NOT commit your actual .env file with secrets to Git.
# Copy this file to .env and configure your environment values.
# ==============================================================

# Server Network Configuration
PORT=8080
TEXT_CHAT_PORT=5000
VOICE_PORT=5001
VIDEO_PORT=5002

# Server Host Binding (e.g., 0.0.0.0 for public binding, localhost for local-only)
SERVER_HOST=0.0.0.0

# Client Connection Target (for desktop clients)
CHAT_SERVER_HOST=localhost

# Security & CORS (Optional: comma-separated origins)
ALLOWED_ORIGINS=*

# Environment Mode (development / production)
NODE_ENV=production
